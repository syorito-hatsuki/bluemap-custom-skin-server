  "authors": [
    "Syorito Hatsuki"
  ],
  "contact": {
    "homepage": "https://syorito-hatsuki.dev/"
  },
  "license": "MIT Licence",
  "icon": "assets/bluemap-custom-skin-server/icon.png",
